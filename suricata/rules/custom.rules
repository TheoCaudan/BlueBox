alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Suspicious HTTP Request to Known Malicious Domain"; flow:to_server; http.host; content:"testmynids.org"; sid:1000001; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ICMP Ping Detected"; itype:8; sid:1000002; rev:1;)
# alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Large HTTP Payload Detected"; flow:to_server; http.request_body; http_content_len:>1000000; sid:1000003; rev:3;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SSH Connection Attempt to Internal Network"; flow:to_server; sid:1000004; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"Telnet Connection Attempt"; flow:to_server; classtype:attempted-admin; sid:10000005; rev:1;)
